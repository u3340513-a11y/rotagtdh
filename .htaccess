RewriteEngine On

# index.html isteklerini köke yönlendir (ör: /index.html -> /)
RewriteCond %{THE_REQUEST} /index\.html([?\s]|$) [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Diğer .html isteklerini uzantısız adrese yönlendir (ör: /iletisim.html -> /iletisim)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Uzantısız adresleri sunucu tarafında ilgili .html dosyasına eşle
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# 404 sayfası (opsiyonel, dosya varsa devreye girer)
ErrorDocument 404 /404.html

# Güvenlik başlıkları
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Önbellekleme
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
